APP_NAME=UploadHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=proyectotgfpodcasts
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Archivos -------------------------------------------------------------
# Disco de los audios (privado) y de las portadas (público).
# En local: MEDIA_DISK=local y COVERS_DISK=public (y php artisan storage:link).
# En producción con S3 o Cloudflare R2: MEDIA_DISK=s3 y rellena AWS_*.
MEDIA_DISK=local
COVERS_DISK=public
MEDIA_MAX_UPLOAD_MB=500
MEDIA_CHUNK_MB=5

# Procesado con ffmpeg (duración, MP3, volumen, forma de onda). Sin ffmpeg, los audios se publican tal cual.
MEDIA_PROCESSING=true
# Rutas de ffmpeg y ffprobe. Vacías: se usan bin/ffmpeg/ (deploy/ffmpeg.sh) o las del PATH.
FFMPEG_BINARY=
FFPROBE_BINARY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Para Cloudflare R2: https://<id-de-cuenta>.r2.cloudflarestorage.com y AWS_DEFAULT_REGION=auto
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Inteligencia artificial (opcional) -----------------------------------
# Transcripción con Whisper (OpenAI): AI_TRANSCRIPTION_DRIVER=openai + OPENAI_API_KEY
AI_TRANSCRIPTION_DRIVER=none
OPENAI_API_KEY=
# Resumen y capítulos con Claude: AI_SUMMARY_DRIVER=anthropic + ANTHROPIC_API_KEY
AI_SUMMARY_DRIVER=none
ANTHROPIC_API_KEY=

# --- Administración -------------------------------------------------------
# Si se rellenan, php artisan db:seed crea este administrador. Si no, usa:
# php artisan user:make-admin correo@ejemplo.com
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Demo pública (ver docs/DESPLIEGUE.md) -------------------------------
# DEMO_MODE=true activa límites, el botón de entrar como ejemplo y el reinicio nocturno.
# ¡Nunca en una instalación con datos reales!
DEMO_MODE=false
DEMO_LOGIN_EMAIL=laura@demo.test
DEMO_MAX_UPLOAD_MB=25
DEMO_RESET_AT=04:00
# Contraseña de los usuarios de la demo (php artisan db:seed --class=DemoSeeder)
DEMO_PASSWORD=

# Tiempo máximo del procesado de audio (en Laravel Cloud con colas Flex: 85)
MEDIA_JOB_TIMEOUT=3600
# URL pública del bucket de portadas en S3/R2
COVERS_PUBLIC_URL=

VITE_APP_NAME="${APP_NAME}"
